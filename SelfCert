        const DEFAULT_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbx3g4l0NJ63zbkfdUep2cb_3W5iRPMPHmKof64BGn9A70L8n95b-j6ABc7NQ1y56di73g/exec";
        const BASE_SHEET_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRe3gZF3EIUIii8YhRagQDLZR5bQP6RRSiTxNMVgWB7aUY6jiQILzD8oNanzZ7Pr_jn_iq3QCfbvGeD/pub";
